# Vande Wellness — copy to .env and fill in your Supabase project values.
# See docs/supabase-setup.md for full setup instructions.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use either name — the app accepts both:
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Web email-confirm redirects (Vercel / production):
# EXPO_PUBLIC_APP_URL=https://your-app.vercel.app
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_VANDECART_BASE_URL=https://vandecart.com
